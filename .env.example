# Copy to .env only when changing local defaults.
HOUSEHOLD_DATABASE_URL=sqlite:///./data/household.db
HOUSEHOLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
HOUSEHOLD_OLLAMA_MODEL=qwen3:4b
# Keep faster-whisper's Hugging Face cache lookup local. The application also
# applies this default at startup, so manual exports are not required.
HF_HUB_OFFLINE=1

# Google Calendar integration. Create an OAuth web client in Google Cloud and
# add this callback URL: http://127.0.0.1:8000/api/google-calendar/callback
HOUSEHOLD_GOOGLE_CLIENT_ID=
HOUSEHOLD_GOOGLE_CLIENT_SECRET=
# Generate once with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
HOUSEHOLD_GOOGLE_TOKEN_ENCRYPTION_KEY=
